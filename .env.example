NODE_ENV=development
PORT=3000
MONGODB_URI=mongodb+srv://<username>:<password>@<cluster>/<database>?retryWrites=true&w=majority
REDIS_HOST=redis
REDIS_PORT=6379
REDIS_PASSWORD=
JWT_ACCESS_SECRET=replace-with-a-long-random-development-access-secret
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_SECRET=replace-with-a-long-random-development-refresh-secret
JWT_REFRESH_EXPIRES_IN=7d
# Base64-encoded 32-byte key. Generate securely; do not reuse this placeholder.
MFA_ENCRYPTION_KEY=replace-with-a-base64-encoded-32-byte-key
MFA_ISSUER=ALSM
CORS_ORIGINS=http://localhost:3001,http://localhost:3002,http://localhost:3003
GOOGLE_CLIENT_ID=963268003293-477mcf0nflkao7pfc1vcgqlbhakncifs.apps.googleusercontent.com
CONVERSION_WORKER_ENABLED=false
# Only bring the worker up (CONVERSION_WORKER_ENABLED=true) after a real engine adapter is configured.
STORAGE_ROOT=./storage
PYTHON_EXECUTABLE=python
# Absolute or relative path to Tool_Convert/py/convert2fe (BMS/DSPF -> React converter). Required for BMS_DSPF_TO_FRONTEND jobs.
TOOL_CONVERT_DIR=../ALSM_TOOL/py/convert2fe
CONVERSION_TOOL_TIMEOUT_MS=120000
JAVA_EXECUTABLE=java
# Absolute or relative path to tool2java's built jar (target/akaBatch-1.0.jar). Required for COBOL_TO_JAVA jobs.
TOOL2JAVA_JAR_PATH=../ALSM_TOOL/tool2java/target/akaBatch-1.0.jar
MAX_UPLOAD_FILE_SIZE_MB=50
# Max number of files accepted in a single conversion-source upload (e.g. a whole COBOL app folder: programs + copybooks)
MAX_UPLOAD_FILES_PER_REQUEST=300
# Casso.vn API key for bank transfer webhook verification
CASSO_API_KEY=

# SMTP (used for password-reset emails)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=465
SMTP_SECURE=true
SMTP_USER=you@gmail.com
SMTP_PASS=your-app-password
SMTP_FROM=ALSM <you@gmail.com>
APP_BASE_URL=http://localhost:5173

# Advisory semantic validation. OpenAI credentials are required only when both enabled and selected.
AI_VALIDATION_ENABLED=false
AI_PROVIDER=fake
OPENAI_API_KEY=
OPENAI_MODEL=
AI_TIMEOUT_MS=60000
AI_MAX_RETRIES=2
AI_MAX_FILES=50
AI_MAX_FILE_CHARS=200000
AI_MAX_TOTAL_CHARS=500000
AI_MAX_FINDINGS=50
AI_PROMPT_VERSION=semantic-cobol-java-v1
VALIDATION_WORKER_ENABLED=false
VALIDATION_WORKER_CONCURRENCY=1
VALIDATION_JOB_ATTEMPTS=2
VALIDATION_JOB_BACKOFF_MS=5000
