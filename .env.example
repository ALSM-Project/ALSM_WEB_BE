NODE_ENV=development
PORT=3000
MONGODB_URI=mongodb://mongodb:27017/alsm
REDIS_HOST=redis
REDIS_PORT=6379
REDIS_PASSWORD=
JWT_ACCESS_SECRET=replace-with-a-long-random-development-access-secret
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_SECRET=replace-with-a-long-random-development-refresh-secret
JWT_REFRESH_EXPIRES_IN=7d
# Base64-encoded 32-byte key. Generate securely; do not reuse this placeholder.
MFA_ENCRYPTION_KEY=replace-with-a-base64-encoded-32-byte-key
MFA_ISSUER=ALSM
CORS_ORIGINS=http://localhost:3001,http://localhost:3002,http://localhost:3003
CONVERSION_WORKER_ENABLED=false
